{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FocusGateSFTRecord",
  "type": "object",
  "required": [
    "id",
    "prompt",
    "completion",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "completion": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "required": ["pipeline", "facet", "oracleVerified"],
      "properties": {
        "pipeline": { "type": "string" },
        "facet": { "type": "string" },
        "oracleVerified": { "type": "boolean" },
        "teacherVersion": { "type": "string" },
        "tokenSavingsRatio": { "type": "number" }
      }
    }
  },
  "additionalProperties": false
}
