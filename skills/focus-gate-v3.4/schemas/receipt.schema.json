{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GateReceipt",
  "description": "Immutable, compact proof receipt produced upon ephemeral session completion in FocusGate v2.5",
  "type": "object",
  "required": [
    "session_id",
    "gate_id",
    "facet",
    "status",
    "key_findings",
    "evidence_hash",
    "elapsed_ms"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Unique ephemeral session identifier (e.g. eph-a1b2c3d4)"
    },
    "gate_id": {
      "type": "string",
      "description": "Target gate ID"
    },
    "facet": {
      "type": "string",
      "description": "Executing sub-skill or facet name"
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL"],
      "description": "Verification status"
    },
    "key_findings": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 3,
      "description": "Up to 3 high-signal key findings or error summaries"
    },
    "artifacts_produced": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths to artifacts generated by this session"
    },
    "evidence_hash": {
      "type": "string",
      "description": "Cryptographic SHA256 digest of session outcomes"
    },
    "elapsed_ms": {
      "type": "number",
      "description": "Execution duration in milliseconds"
    },
    "tokens_used": {
      "type": "integer",
      "description": "Estimated tokens consumed in prompt seed"
    }
  },
  "additionalProperties": false
}
